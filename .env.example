# Copy to .env.local (gitignored). Tests and the build run without real values.

# Browser: Supabase project URL + publishable (anon) key. RLS keeps these read-only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server (/api routes) and scheduled scripts.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The Odds API (https://the-odds-api.com). Scheduled scripts only.
ODDS_API_KEY=
